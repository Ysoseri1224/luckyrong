---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Lucky Rong">
  <main class="max-w-3xl mx-auto px-5 py-10 md:py-16">

    <!-- 双城时钟 -->
    <div class="flex justify-center items-center gap-6 mb-8 text-sm font-medium text-plum-600">
      <span class="flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-lavender-400 inline-block"></span>
        <span>奥克兰</span>
        <span id="clock-auckland" class="font-mono text-plum-900">--:--</span>
      </span>
      <span class="text-plum-300">|</span>
      <span class="flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-rose-300 inline-block"></span>
        <span>山东</span>
        <span id="clock-shandong" class="font-mono text-plum-900">--:--</span>
      </span>
    </div>

    <!-- 时间大卡 -->
    <div class="bg-white/70 backdrop-blur-sm rounded-3xl p-8 md:p-10 shadow-sm border border-plum-100 mb-10 text-center">
      <p class="text-sm text-plum-400 mb-2 tracking-wide">在一起</p>
      <div id="together-counter" class="text-3xl md:text-4xl font-bold text-plum-900 font-mono tabular-nums mb-6">
        ---天 --:--:--
      </div>
      <div class="h-px bg-plum-100 my-5"></div>
      <p class="text-sm text-plum-400 mb-2 tracking-wide">下次见面</p>
      <div id="meet-counter" class="text-2xl md:text-3xl font-semibold text-lavender-600 font-mono tabular-nums cursor-pointer hover:text-lavender-700 transition-colors" title="点击设置见面日期">
        点击设置日期
      </div>
    </div>

    <!-- 流式卡片网格 -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <a href="/together/" class="group block p-6 bg-white/70 backdrop-blur-sm rounded-2xl shadow-sm border border-plum-100 hover:shadow-md hover:border-rose-200 transition-all">
        <div class="w-9 h-9 rounded-xl bg-rose-100 flex items-center justify-center mb-3 group-hover:bg-rose-200 transition-colors">
          <svg class="w-5 h-5 text-rose-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
        </div>
        <h3 class="text-base font-semibold text-plum-900 mb-1">Together Time</h3>
        <p class="text-sm text-plum-500">时差日程与纪念记录</p>
      </a>

      <a href="/cet6/" class="group block p-6 bg-white/70 backdrop-blur-sm rounded-2xl shadow-sm border border-plum-100 hover:shadow-md hover:border-lavender-200 transition-all">
        <div class="w-9 h-9 rounded-xl bg-lavender-100 flex items-center justify-center mb-3 group-hover:bg-lavender-200 transition-colors">
          <svg class="w-5 h-5 text-lavender-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
        </div>
        <h3 class="text-base font-semibold text-plum-900 mb-1">CET6 Camp</h3>
        <p class="text-sm text-plum-500">六级备考计划与资源</p>
      </a>

      <div class="md:col-span-2 p-6 bg-white/70 backdrop-blur-sm rounded-2xl shadow-sm border border-plum-100">
        <h3 class="text-sm font-semibold text-plum-400 uppercase tracking-wide mb-4">共同心愿</h3>
        <ul id="wishlist" class="space-y-2.5 text-sm text-plum-700">
          <li class="flex items-center gap-2"><span class="w-4 h-4 rounded border border-plum-200 flex-shrink-0"></span>长白山-长相守，共白头</li>
          <li class="flex items-center gap-2"><span class="w-4 h-4 rounded border border-plum-200 flex-shrink-0"></span>徐州逛吃嘻嘻</li>
          <li class="flex items-center gap-2"><span class="w-4 h-4 rounded border border-plum-200 flex-shrink-0"></span>买花，做成冰箱贴~</li>
          <li class="flex items-center gap-2"><span class="w-4 h-4 rounded border border-plum-200 flex-shrink-0"></span>坐一次双层火车的大床卧铺，去大理</li>
          <li class="flex items-center gap-2"><span class="w-4 h-4 rounded border border-plum-200 flex-shrink-0"></span>每年都要拍一张红底照片！</li>
        </ul>
      </div>
    </div>

  </main>

  <!-- 见面日期设置弹窗 -->
  <dialog id="meet-dialog" class="rounded-2xl p-6 shadow-xl border border-plum-100 backdrop:bg-black/30">
    <form method="dialog" class="space-y-4">
      <h3 class="text-lg font-semibold text-plum-900">设置下次见面日期</h3>
      <div class="grid grid-cols-3 gap-2">
        <label class="field">
          <span class="text-xs text-plum-400">年</span>
          <select id="meet-year" class="w-full px-3 py-2 rounded-xl border border-plum-200 text-plum-900 focus:outline-none focus:border-lavender-400">
            <option value="2026">2026</option><option value="2027">2027</option><option value="2028">2028</option>
          </select>
        </label>
        <label class="field">
          <span class="text-xs text-plum-400">月</span>
          <select id="meet-month" class="w-full px-3 py-2 rounded-xl border border-plum-200 text-plum-900 focus:outline-none focus:border-lavender-400"></select>
        </label>
        <label class="field">
          <span class="text-xs text-plum-400">日</span>
          <select id="meet-day" class="w-full px-3 py-2 rounded-xl border border-plum-200 text-plum-900 focus:outline-none focus:border-lavender-400"></select>
        </label>
      </div>
      <div class="grid grid-cols-2 gap-2">
        <label class="field">
          <span class="text-xs text-plum-400">时</span>
          <select id="meet-hour" class="w-full px-3 py-2 rounded-xl border border-plum-200 text-plum-900 focus:outline-none focus:border-lavender-400"></select>
        </label>
        <label class="field">
          <span class="text-xs text-plum-400">分</span>
          <select id="meet-minute" class="w-full px-3 py-2 rounded-xl border border-plum-200 text-plum-900 focus:outline-none focus:border-lavender-400"></select>
        </label>
      </div>
      <div class="flex gap-3">
        <button type="submit" id="meet-save" class="flex-1 px-4 py-2.5 bg-lavender-500 text-white rounded-xl font-medium hover:bg-lavender-600 transition-colors">保存</button>
        <button type="submit" id="meet-cancel" class="px-4 py-2.5 text-plum-500 rounded-xl font-medium hover:bg-plum-50 transition-colors">取消</button>
      </div>
    </form>
  </dialog>

  <script>
    const TOGETHER_START = new Date('2026-01-25T21:24:00+08:00').getTime();
    const MEET_KEY = 'luckyrong_meet_date';

    function pad(n) { return String(n).padStart(2, '0'); }

    function updateClocks() {
      const now = new Date();
      const auckland = now.toLocaleTimeString('en-NZ', { timeZone: 'Pacific/Auckland', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
      const shandong = now.toLocaleTimeString('zh-CN', { timeZone: 'Asia/Shanghai', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
      document.getElementById('clock-auckland').textContent = auckland;
      document.getElementById('clock-shandong').textContent = shandong;
    }

    function updateCounters() {
      const now = Date.now();
      const diff = now - TOGETHER_START;
      const days = Math.floor(diff / 86400000);
      const h = Math.floor((diff % 86400000) / 3600000);
      const m = Math.floor((diff % 3600000) / 60000);
      const s = Math.floor((diff % 60000) / 1000);
      document.getElementById('together-counter').textContent = `${days}天 ${pad(h)}:${pad(m)}:${pad(s)}`;

      const meetDate = localStorage.getItem(MEET_KEY);
      const meetEl = document.getElementById('meet-counter');
      if (meetDate) {
        const meetDiff = new Date(meetDate).getTime() - now;
        if (meetDiff > 0) {
          const md = Math.floor(meetDiff / 86400000);
          const mh = Math.floor((meetDiff % 86400000) / 3600000);
          const mm = Math.floor((meetDiff % 3600000) / 60000);
          const ms = Math.floor((meetDiff % 60000) / 1000);
          meetEl.textContent = `${md}天 ${pad(mh)}:${pad(mm)}:${pad(ms)}`;
        } else {
          meetEl.textContent = '已见面!';
        }
      } else {
        meetEl.textContent = '点击设置日期';
      }
    }

    // 见面日期弹窗
    const dialog = document.getElementById('meet-dialog');
    const meetCounter = document.getElementById('meet-counter');
    const meetSave = document.getElementById('meet-save');
    const meetYear = document.getElementById('meet-year');
    const meetMonth = document.getElementById('meet-month');
    const meetDay = document.getElementById('meet-day');
    const meetHour = document.getElementById('meet-hour');
    const meetMinute = document.getElementById('meet-minute');

    for (let i = 1; i <= 12; i++) meetMonth.innerHTML += `<option value="${i}">${i}月</option>`;
    for (let i = 1; i <= 31; i++) meetDay.innerHTML += `<option value="${i}">${i}日</option>`;
    for (let i = 0; i < 24; i++) meetHour.innerHTML += `<option value="${i}">${pad(i)}时</option>`;
    for (let i = 0; i < 60; i += 5) meetMinute.innerHTML += `<option value="${i}">${pad(i)}分</option>`;

    meetCounter.addEventListener('click', () => {
      const saved = localStorage.getItem(MEET_KEY);
      if (saved) {
        const d = new Date(saved);
        meetYear.value = d.getFullYear();
        meetMonth.value = d.getMonth() + 1;
        meetDay.value = d.getDate();
        meetHour.value = d.getHours();
        meetMinute.value = Math.floor(d.getMinutes() / 5) * 5;
      }
      dialog.showModal();
    });

    meetSave.addEventListener('click', () => {
      const dt = new Date(Number(meetYear.value), Number(meetMonth.value) - 1, Number(meetDay.value), Number(meetHour.value), Number(meetMinute.value));
      localStorage.setItem(MEET_KEY, dt.toISOString());
    });

    updateClocks();
    updateCounters();
    setInterval(() => { updateClocks(); updateCounters(); }, 1000);
  </script>
</Layout>
