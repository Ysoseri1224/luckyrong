---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Lucky Rong">
  <main class="max-w-2xl mx-auto px-6 py-20">
    <header class="mb-16 text-center">
      <h1 class="text-4xl font-bold text-amber-900 mb-4">Lucky Rong</h1>
      <p class="text-lg text-gray-600">一个记录学习与成长的小站。</p>
    </header>

    <section>
      <h2 class="text-sm font-medium text-gray-400 uppercase tracking-wide mb-6">导航</h2>
      <div class="grid gap-4">
        <a
          href="/cet6/"
          class="block p-6 bg-white rounded-xl shadow-sm border border-gray-100 hover:shadow-md hover:border-amber-200 transition-all"
        >
          <h3 class="text-lg font-semibold text-gray-900 mb-1">CET6 Camp</h3>
          <p class="text-sm text-gray-500">六级备考计划与资源整理</p>
        </a>
        <a
          href="/together/"
          class="block p-6 bg-white rounded-xl shadow-sm border border-gray-100 hover:shadow-md hover:border-amber-200 transition-all"
        >
          <h3 class="text-lg font-semibold text-gray-900 mb-1">Together Time</h3>
          <p class="text-sm text-gray-500">异地情侣时差日程与纪念记录</p>
        </a>
      </div>
    </section>
  </main>
</Layout>
